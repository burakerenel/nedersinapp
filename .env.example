NODE_ENV=development
PORT=3000
# Fotoğraf URL'leri için dışarıdan erişilen adres (yoksa istekten türetilir)
PUBLIC_BASE_URL=https://test-api.nedersin.app

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=nedersinapp
DB_SSL=false
# Şema senkronizasyonu: boşsa NODE_ENV!=production iken açık. production'da
# kolon eklemek için bir kez DB_SYNC=true ile çalıştırılabilir.
# DB_SYNC=true

# JWT
JWT_SECRET=change_me_in_production_use_strong_secret
JWT_EXPIRES_IN=7d

# E-posta (şifre sıfırlama kodu). SMTP_HOST boşsa kod log'a yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NeDersin <no-reply@nedersin.app>"

# Google ile giriş: iOS + Android (+ web) client ID'leri, virgülle
GOOGLE_CLIENT_IDS=

# Apple ile giriş
APPLE_CLIENT_IDS=com.gbga.nedersin
# Hesap silmede Apple token iptali için (opsiyonel; yoksa iptal atlanır)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM içeriği, satır sonları \n ile tek satırda
APPLE_PRIVATE_KEY=

# Yorum fotoğrafları: DigitalOcean Spaces (S3 uyumlu). Boşsa yerel diske (UPLOADS_DIR) yazılır.
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=fra1
# SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# CDN adresi (Spaces panelinde "Enable CDN"); boşsa https://<bucket>.<region>.digitaloceanspaces.com
SPACES_PUBLIC_URL=
# Anahtar ön eki, örn. test → test/review-images/... (test ve prod aynı bucket'ı paylaşırsa)
SPACES_PREFIX=
# Yerel disk fallback klasörü (Spaces tanımlı değilse)
UPLOADS_DIR=uploads
